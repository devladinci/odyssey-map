{
  "name": "odyssey-map",
  "version": "1.0.0",
  "description": "An interactive map for readers of Homer's Odyssey",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "node scripts/check-content.mjs && node scripts/check-routes.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "maplibre-gl": "^6.18.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "pmtiles": "^4.5.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "type": "module",
  "private": true,
  "homepage": "https://devladinci.github.io/odyssey-map/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devladinci/odyssey-map.git"
  }
}
